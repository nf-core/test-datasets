import groovy.io.FileType
import java.security.MessageDigest

nextflow_pipeline {

    name "Test Workflow main.nf"
    script "main.nf"

    test("Regenerate and validate the canonical compact GWAS fixtures") {

        when {
            params {
                outdir_fixtures = "${workDir}/published"
            }
        }

        then {
            assert workflow.success
            assert workflow.exitStatus == 0
            assert workflow.trace.tasks().size() == 1

            def generatedRoot = new File("${workDir}/published")
            def generatedFiles = []
            generatedRoot.eachFileRecurse(FileType.FILES) { generatedFile ->
                generatedFiles << generatedRoot.toPath().relativize(generatedFile.toPath()).toString()
            }
            assert generatedFiles.sort() == [
                "genotypes/example_all.vcf.gz",
                "pheno_cov/example.catcovar",
                "pheno_cov/example.pheno",
                "pheno_cov/example.qcovar",
                "relational/analysis_manifest_association_only.csv",
                "relational/analysis_manifest_binary.csv",
                "relational/analysis_manifest_heritability_only.csv",
                "relational/analysis_manifest_heterogeneous.csv",
                "relational/analysis_manifest_quantitative.csv",
                "relational/cohort_manifest.csv",
                "relational/method_options_heterogeneous.json",
                "relational/resources/gcta_grm_extract.txt",
                "relational/resources/ldak_predictor_extract.txt",
                "relational/resources/ldak_weights.txt"
            ]

            generatedFiles.each { relativePath ->
                def generated = new File(generatedRoot, relativePath)
                def canonical = new File("${projectDir}/results/fixtures", relativePath)
                assert canonical.isFile(), "Missing canonical fixture: ${relativePath}"
                assert sha256(generated) == sha256(canonical), "Regenerated bytes differ: ${relativePath}"
            }
        }
    }
}

def sha256(File inputFile) {
    def digest = MessageDigest.getInstance("SHA-256")
    inputFile.withInputStream { input ->
        byte[] buffer = new byte[8192]
        int count
        while ((count = input.read(buffer)) > 0) {
            digest.update(buffer, 0, count)
        }
    }
    digest.digest().encodeHex().toString()
}
