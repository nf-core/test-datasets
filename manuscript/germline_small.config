/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running full-size tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a full size pipeline test.

    Use as follows:
        nextflow run nf-core/variantbenchmarking -r 1.4.0 -profile <docker/singularity> -c germline_small.config

----------------------------------------------------------------------------------------
*/

params {
    max_cpus            = 16
    max_memory          = 100.GB
    max_time            = '8.h'

    config_profile_name        = 'Test profile: germline_small'
    config_profile_description = 'Benchmarking small variants of Freebayes, Haplotypecaller, Strelka and Deepvariant from Sarek 3.6.0 against HG001'
    test_data_base      = 'https://raw.githubusercontent.com/nf-core/test-datasets/variantbenchmarking'

    // Input data
    input               = "${params.test_data_base}/manuscript/samplesheet/germline_small.csv"
    outdir              = 'germline_small'

    // Genome references
    genome              = 'GRCh38'
    analysis            = 'germline'
    variant_type        = "small"
    method              = 'happy'
    preprocess          = "split_multiallelic,normalize,deduplicate,filter_contigs"
    exclude_expression = 'GT="0/0" || GT="./." || STRLEN(REF)>50 || STRLEN(ALT)>50'

    // Truth 
    truth_id            = "HG001"
    truth_vcf           = "https://ftp-trace.ncbi.nlm.nih.gov/ReferenceSamples/giab/release/NA12878_HG001/NISTv4.2.1/GRCh38/HG001_GRCh38_1_22_v4.2.1_benchmark.vcf.gz"
    targets_bed         = "https://ftp-trace.ncbi.nlm.nih.gov/ReferenceSamples/giab/release/NA12878_HG001/NISTv4.2.1/GRCh38/HG001_GRCh38_1_22_v4.2.1_benchmark.bed"
    regions_bed         = "s3://ngi-igenomes/test-data/sarek/Agilent_v7.bed"
    falsepositive_bed   = "https://ftp-trace.ncbi.nlm.nih.gov/ReferenceSamples/giab/release/NA12878_HG001/NISTv4.2.1/GRCh38/SupplementaryFiles/HG001_GRCh38_1_22_v4.2.1_filteredsites.bed"
}