/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running full-size tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a fast and simple pipeline test.

    Use as follows:
        nextflow run nf-core/variantbenchmarking -r 1.4.0 -profile <docker/singularity> -c somatic_bnd.config

----------------------------------------------------------------------------------------
*/
params {
    max_cpus                   = 16
    max_memory                 = 100.GB
    max_time                   = '8.h'

    config_profile_name        = 'Test profile: somatic_bnd'
    config_profile_description = 'Benchmarking small variants of Manta and Tiddit from Sarek 3.6.0 against SEQC2'
    test_data_base             = 'https://raw.githubusercontent.com/nf-core/test-datasets/variantbenchmarking'

    // Input data
    input                      = "${params.test_data_base}/manuscript/samplesheet/somatic_sv.csv"
    outdir                     = "somatic_sv"

    // Genome references
    genome                     = "GRCh38"
    analysis                   = "somatic"
    variant_type               = "structural"
    method                     = "bndeval"
    preprocess                 = "split_multiallelic,normalize,deduplicate,filter_contigs"
    min_sv_size                = 30
    sv_standardization         = "svdecompose"

    // Truth 
    truth_id                   = "SEQC2"
    truth_vcf                  = "${params.test_data_base}/testdata/hg38/truth/somatic/13059_2022_2816_MOESM4_ESM.svconverted.vcf"
    regions_bed                = "s3://nf-core-awsmegatests/sarek/input/S07604624_Padded_Agilent_SureSelectXT_allexons_V6_UTR.bed"
}