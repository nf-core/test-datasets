/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running full-size tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a fast and simple pipeline test.

    Use as follows:
        nextflow run nf-core/variantbenchmarking -r 1.4.0 -profile <docker/singularity> -c germline_sv.config

----------------------------------------------------------------------------------------
*/
params {

    max_cpus                   = 16
    max_memory                 = 100.GB
    max_time                   = '8.h'

    config_profile_name        = 'Test profile: germline_sv'
    config_profile_description = 'Benchmarking small variants of Manta and Tiddit from Sarek 3.6.0 against HG001'
    test_data_base             = 'https://raw.githubusercontent.com/nf-core/test-datasets/variantbenchmarking'

    // Input data
    input                       = "${params.test_data_base}/manuscipt/samplesheet/germline_sv.csv"
    outdir                      = "germline_sv"

    // Genome references
    genome                      = "GRCh38"
    analysis                    = "germline"
    variant_type                = "structural"
    method                      = "truvari"
    preprocess                  = "split_multiallelic,deduplicate,filter_contigs"
    min_sv_size                 = 30
    exclude_expression          = 'GT="0/0" || GT="./."'

    // Truth 
    truth_id                    = "HG001"
    truth_vcf                   = "${params.test_data_base}/testdata/hg38/truth/germline/GRCh38_HG001_v4.2.1_CNVsandSVs.vcf.gz"
}