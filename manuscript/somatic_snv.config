/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running full-size tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a fast and simple pipeline test.

    Use as follows:
        nextflow run nf-core/variantbenchmarking -r 1.4.0 -profile <docker/singularity> -c somatic_snv.config

----------------------------------------------------------------------------------------
*/
params {
    max_cpus                   = 16
    max_memory                 = 100.GB
    max_time                   = '8.h'

    config_profile_name        = 'Test profile: somatic_snv'
    config_profile_description = 'Benchmarking small variants of Freebayes, Mutect2, Strelka and Muse from Sarek 3.6.0 against SEQC2'
    test_data_base             = 'https://raw.githubusercontent.com/nf-core/test-datasets/variantbenchmarking'

    // Input data
    input                      = "${params.test_data_base}/manuscript/samplesheet/somatic_snv.csv"
    outdir                     = 'somatic_snv'

    // Genome references
    genome                     = 'GRCh38'
    analysis                   = 'somatic'
    method                     = 'sompy'
    variant_type               = "snv"
    preprocess                 = "split_multiallelic,normalize,deduplicate,filter_contigs"
    include_expression         = 'TYPE="snp"'

    // Truth 
    truth_id                   = "SEQC2"
    truth_vcf                  = "${params.test_data_base}/testdata/hg38/truth/somatic/high-confidence_sSNV_in_HC_regions_v1.2_gt.vcf"
    regions_bed                = "https://ftp-trace.ncbi.nlm.nih.gov/ReferenceSamples/seqc/Somatic_Mutation_WG/release/latest/High-Confidence_Regions_v1.2.bed"
    targets_bed                = "s3://nf-core-awsmegatests/sarek/input/S07604624_Padded_Agilent_SureSelectXT_allexons_V6_UTR.bed"
}
