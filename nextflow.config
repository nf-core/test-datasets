params {
	outdir_base = "results"
	outdir_vcfs = "${params.outdir_base}/vcfs"
	outdir_chunked_vcfs = "${params.outdir_base}/chunked_vcfs"
	outdir_pheno_cov = "${params.outdir_base}/pheno_cov"
	outdir_fixtures = "${params.outdir_base}/fixtures"
	outdir_fixture_genotypes = "${params.outdir_fixtures}/genotypes"
	outdir_fixture_pheno_cov = "${params.outdir_fixtures}/pheno_cov"

	// Source-data stage. Set to true to regenerate the GWAS fixtures without
	// re-downloading the 1000 Genomes release, which is the normal case: the
	// chromosome-chunked VCFs the fixtures derive from are already committed.
	skip_source_generation = false

	// GWAS fixture generation. Derives from the committed chunked VCFs only.
	chunked_vcfs_dir = "${projectDir}/${params.outdir_base}/chunked_vcfs"
	fixture_prefix = "example"
	fixture_chromosomes = "chr1,chr2,chr3,chr4,chr5,chr6,chr7,chr8,chr9,chr10,chr11,chr12,chr13,chr14,chr15,chr16,chr17,chr18,chr19,chr20,chr21,chr22"
	fixture_n_samples = 500
	fixture_sample_stride = 5
	fixture_maf = 0.005
	fixture_ld_window = 100
	fixture_ld_step = 10
	fixture_ld_r2 = 0.2
	fixture_n_pcs_computed = 10
	fixture_n_pcs = 5
	fixture_n_causal = 150
	fixture_h2 = 0.5
	fixture_covariate_variance = 0.1
	fixture_prevalence = 0.3
	fixture_seed = 20260101
}

// Profile-specific configurations
profiles {
    hpc {
        singularity {
            enabled = true
            autoMounts = true
        }
    }
    gcp {
        process {
            executor = 'google-batch'
            // Disabling publish to save resources by avoid duplicate outputs in bucket
            publishDir = [enabled: false]
        }

        workDir = 'gs://test-datasets-gwas-prod-results-bucket/work'

        google {
            project = 'test-datasets-gwas'
            location = 'us-central1'
            batch.spot = true
        }

        process {
            errorStrategy = { task.exitStatus==50001 ? 'retry' : 'terminate' }
            maxRetries = 5
        }
    }

    test {
        docker {
            enabled = true
            runOptions = '-u $(id -u):$(id -g)'
        }
        
        // Optional: Add resource limits for CI
        process {
            cpus = 2
            memory = 6.GB
            time = 4.h
        }
    }
}